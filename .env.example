# Copy to .env.local, and add the same names in Vercel → Project → Settings → Environment Variables.
# With nothing set the site still works: booking and setup forms fall back to a pre-filled email.

# Supabase (Living-Assistance project). Bookings and setup forms are saved in its private `leads` schema
# (see supabase/leads.sql). The publishable key can only call the three lead functions.
SUPABASE_URL=https://nglpmviaarbogpcuhiai.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Email (Resend). ophlow.com is verified there, so we can email the visitor as well as ourselves.
RESEND_API_KEY=
# Optional: defaults to "Ophlow <demos@ophlow.com>". Must be on a verified domain.
EMAIL_FROM=
NOTIFY_TO=ophlow@gmail.com

# Google Calendar (OAuth as ophlow@gmail.com; a plain API key can't read private calendars). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated calendars to check for busy times (teammates share theirs with ophlow@gmail.com).
GOOGLE_CALENDAR_IDS=ophlow@gmail.com
# true = also put each demo on ophlow@gmail.com's calendar. The visitor gets their invite by email, not from Google.
GOOGLE_CREATE_EVENTS=false

# Zoom: a Server-to-Server OAuth app (see README). Each demo gets its own meeting, hosted by ZOOM_HOST_EMAIL.
# Not set: the demo gets a Google Meet link if calendar events are on, otherwise we send a link by hand.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
